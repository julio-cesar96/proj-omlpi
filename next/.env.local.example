# ── APIs de backend ──────────────────────────────────────────────────────────
STRAPI_API_URL=
OMLPI_API_URL=
CMS_SEARCH_API_URL=

# ── Analytics (NEXT_PUBLIC_ = exposto no client) ─────────────────────────────
# Google Analytics 4 — Measurement ID (formato G-XXXXXXXXXX)
# Nota de referência: O ID UA-180028503-1 legado (Universal Analytics) está inativo
NEXT_PUBLIC_GA_ID=

# Facebook Pixel ID
NEXT_PUBLIC_FB_PIXEL_ID=

# ── Sentry ────────────────────────────────────────────────────────────────────
# DSN para o projeto Next.js (Server-side e client-side)
# Nota de referência: DSN legada 'https://afa524ecfc15511efdd238c7f5fe8492@o75154.ingest.sentry.io/4505987756589056'
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# Auth token para upload de source maps durante o build
SENTRY_AUTH_TOKEN=

# ── Contato via Web3Forms ─────────────────────────────────────────────────────
# Chave de acesso do Web3Forms (https://web3forms.com) — server-only, sem NEXT_PUBLIC_
# Na Vercel: Settings → Environment Variables → WEB3FORMS_KEY
WEB3FORMS_KEY=
