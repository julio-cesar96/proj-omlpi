{
  "kind": "collectionType",
  "collectionName": "locales",
  "info": {
    "name": "Planos",
    "description": ""
  },
  "options": {
    "increments": true,
    "timestamps": true,
    "draftAndPublish": true
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "type": {
      "type": "enumeration",
      "enum": [
        "city",
        "state",
        "region"
      ],
      "required": true
    },
    "cod_ibge": {
      "name": "Cód. IBGE",
      "description": "https://ibge.gov.br/explica/",
      "type": "integer",
      "required": false
    },
    "state": {
      "type": "enumeration",
      "enum": [
        "AC",
        "AL",
        "AP",
        "AM",
        "BA",
        "CE",
        "DF",
        "ES",
        "GO",
        "MA",
        "MT",
        "MS",
        "MG",
        "PA",
        "PB",
        "PR",
        "PE",
        "PI",
        "RJ",
        "RN",
        "RS",
        "RO",
        "RR",
        "SC",
        "SP",
        "SE",
        "TO"
      ],
      "required": true
    },
    "plan": {
      "model": "file",
      "via": "related",
      "allowedTypes": [
        "files",
        "images",
        "videos"
      ],
      "plugin": "upload",
      "required": false
    },
    "region": {
      "type": "enumeration",
      "enum": [
        "norte",
        "nordeste",
        "centro_oeste",
        "sudeste",
        "sul"
      ],
      "required": true
    },
    "is_capital": {
      "type": "boolean"
    },
    "is_law": {
      "type": "boolean"
    }
  }
}
